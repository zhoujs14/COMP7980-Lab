<html>

<head>
  <title>Search Result</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
  <style>
    #container {
      flex-wrap: wrap;
      justify-content: center;
    }

    .card {
      width: 15rem;
      cursor: pointer;
    }

    .card-img-top {
      width: 14rem;
      height: 20rem;
      object-fit: cover
    }

    nav {
      width: 100%;
    }

    ul {
      width: 100%;
      flex-wrap: wrap;
    }

    li {
      white-space: nowrap;
    }
  </style>
</head>

<body>
  <h1 style="text-align: center">Search Result</h1>
  <div class="row" id="container">
    <% for (var booking of bookings) { %>
      <div class="card col-xs-6 col-md-4 col-lg-2" onclick="onClick('<%= booking._id %>')">
        <img class="card-img-top" src="./img/<%= booking.superhero %>.jpg" alt="<%= booking.superhero %>">
        <div class="card-body">
          <p>email: <%= booking.email %>
          </p>
          <p>numTickets: <%= booking.numTickets %>
          </p>
          <p>payment method: <%= booking.payment %>
          </p>
        </div>
      </div>
      <% } %>
  </div>

  <hr>

  <nav aria-label="Page navigation example">
    <ul class="pagination" style="flex: wrap;">
      <li class="page-item"><a class="page-link"
          href="/searchBookings?perPage=6&page=<%= lastPage %><%= parameters %>">Previous</a></li>
      <% for (var i=1; i <=pages; i++) { %>
        <li id="page<%= i %>" class="page-item"><a class="page-link"
            href="/searchBookings?perPage=6&page=<%= i %><%= parameters %>">
            <%= i %>
          </a></li>
        <% } %>
          <li class="page-item"><a class="page-link"
              href="/searchBookings?perPage=6&page=<%= nextPage %><%= parameters %>">Next</a></li>
    </ul>
  </nav>

  <script>
    function onClick(id) {
      window.location.href = "http://localhost:3000/bookings/update/" + id
    }

    // active current page item
    const urlParams = new URLSearchParams(window.location.search);
    let cur = urlParams.get("page")
    if (!cur) cur = '1'
    document.getElementById('page' + cur).classList.add('active')
  </script>
</body>

</html>